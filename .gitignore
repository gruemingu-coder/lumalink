# TypeScript build cache + emitted output for the Vite/Node config
# project (tsconfig.node.json has composite:true, which makes `tsc -b`
# emit vite.config.js/.d.ts next to vite.config.ts — these are build
# artifacts, not source).
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Rust / Tauri build artifacts (root client app + host-app)
src-tauri/target
host-app/src-tauri/target
host-app/node_modules
host-app/dist
# Auto-generated by Tauri for capabilities autocompletion — regenerated
# on every build, not meant to be committed (matches Tauri's own
# default template .gitignore).
gen/schemas
.git_log_tmp.txt
