{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaLink",
  "version": "0.3.0",
  "identifier": "org.lumalink.streamingapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaLink",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "LumaLink",
    "category": "Game",
    "shortDescription": "LumaLink Streaming App - remote PC game streaming client",
    "longDescription": "Native desktop client for LumaLink. Connects to a LumaLink Host App over your local network and streams your PC games with low latency.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
