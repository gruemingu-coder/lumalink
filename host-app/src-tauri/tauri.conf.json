{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaLink Host",
  "version": "0.1.1",
  "identifier": "org.lumalink.hostapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaLink Host",
        "width": 480,
        "height": 720,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "LumaLink",
    "category": "Utility",
    "shortDescription": "LumaLink Host App - share this PC's games with LumaLink clients",
    "longDescription": "Runs on your gaming PC. Shows a pairing PIN, lists installed Steam games, and streams your screen to a paired LumaLink Streaming App client over your local network using WebRTC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
