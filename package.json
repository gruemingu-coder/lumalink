{
  "name": "lumalink",
  "private": true,
  "version": "0.1.0",
  "description": "LumaLink - independent demo project for a remote PC game streaming client (React + TypeScript + Tailwind CSS).",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
